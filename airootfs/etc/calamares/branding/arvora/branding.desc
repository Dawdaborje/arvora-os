---
# Arvora OS Calamares Branding
# This file contains the branding information for Calamares

# General branding
componentName: "Arvora OS Installer"
componentVersion: "3.3.8"
componentIcon: "arvora-logo"
componentLogo: "arvora-logo"
componentUrl: "https://github.com/Dawdaborje/arvora-os"
componentAuthor: "Arvora OS Team"
componentLicense: "GPL-3.0-or-later"

# Slideshow
slideshowAPI: 1
slideshow: "slideshow.qml"

# Style
style: "style.qss"

# Strings
strings:
  - id: "welcome"
    string: "Welcome to Arvora OS"
  - id: "welcome_message"
    string: "This will install Arvora OS on your computer."
  - id: "welcome_details"
    string: "Arvora OS is a personal Linux distribution based on Arch Linux, designed for learning and exploration."
