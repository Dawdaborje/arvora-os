#!/usr/bin/env bash
# Arvora OS Diagnostic Tool
# Comprehensive system diagnostics and troubleshooting

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Diagnostic report file
REPORT_FILE="/tmp/arvora_diagnostics_$(date +%Y%m%d_%H%M%S).txt"

# Logging function
log() {
    echo -e "${BLUE}[$(date +'%Y-%m-%d %H:%M:%S')]${NC} $1"
}

# Section header
section() {
    echo -e "${CYAN}=== $1 ===${NC}"
    echo "=== $1 ===" >> "$REPORT_FILE"
}

# Information gathering
gather_system_info() {
    section "System Information"
    
    echo "Date: $(date)" >> "$REPORT_FILE"
    echo "Kernel: $(uname -r)" >> "$REPORT_FILE"
    echo "Architecture: $(uname -m)" >> "$REPORT_FILE"
    echo "Hostname: $(hostname)" >> "$REPORT_FILE"
    echo "Uptime: $(uptime)" >> "$REPORT_FILE"
    echo "Load Average: $(cat /proc/loadavg)" >> "$REPORT_FILE"
    echo "" >> "$REPORT_FILE"
    
    log "System information gathered"
}

gather_hardware_info() {
    section "Hardware Information"
    
    # CPU Info
    echo "CPU Information:" >> "$REPORT_FILE"
    if [[ -f /proc/cpuinfo ]]; then
        echo "CPU Model: $(grep "model name" /proc/cpuinfo | head -1 | cut -d: -f2 | xargs)" >> "$REPORT_FILE"
        echo "CPU Cores: $(nproc)" >> "$REPORT_FILE"
        echo "CPU Threads: $(grep -c processor /proc/cpuinfo)" >> "$REPORT_FILE"
    fi
    echo "" >> "$REPORT_FILE"
    
    # Memory Info
    echo "Memory Information:" >> "$REPORT_FILE"
    if [[ -f /proc/meminfo ]]; then
        echo "Total Memory: $(grep MemTotal /proc/meminfo | awk '{print $2 " KB"}')" >> "$REPORT_FILE"
        echo "Available Memory: $(grep MemAvailable /proc/meminfo | awk '{print $2 " KB"}')" >> "$REPORT_FILE"
        echo "Free Memory: $(grep MemFree /proc/meminfo | awk '{print $2 " KB"}')" >> "$REPORT_FILE"
    fi
    echo "" >> "$REPORT_FILE"
    
    # Storage Info
    echo "Storage Information:" >> "$REPORT_FILE"
    df -h >> "$REPORT_FILE"
    echo "" >> "$REPORT_FILE"
    
    log "Hardware information gathered"
}

gather_network_info() {
    section "Network Information"
    
    # Network interfaces
    echo "Network Interfaces:" >> "$REPORT_FILE"
    ip addr show >> "$REPORT_FILE"
    echo "" >> "$REPORT_FILE"
    
    # Routing table
    echo "Routing Table:" >> "$REPORT_FILE"
    ip route show >> "$REPORT_FILE"
    echo "" >> "$REPORT_FILE"
    
    # DNS configuration
    echo "DNS Configuration:" >> "$REPORT_FILE"
    cat /etc/resolv.conf >> "$REPORT_FILE" 2>/dev/null || echo "No resolv.conf found" >> "$REPORT_FILE"
    echo "" >> "$REPORT_FILE"
    
    # Network connectivity test
    echo "Network Connectivity Tests:" >> "$REPORT_FILE"
    if ping -c 1 8.8.8.8 >/dev/null 2>&1; then
        echo "Internet connectivity: OK" >> "$REPORT_FILE"
    else
        echo "Internet connectivity: FAILED" >> "$REPORT_FILE"
    fi
    
    if nslookup archlinux.org >/dev/null 2>&1; then
        echo "DNS resolution: OK" >> "$REPORT_FILE"
    else
        echo "DNS resolution: FAILED" >> "$REPORT_FILE"
    fi
    echo "" >> "$REPORT_FILE"
    
    log "Network information gathered"
}

gather_package_info() {
    section "Package Management Information"
    
    # Pacman configuration
    echo "Pacman Configuration:" >> "$REPORT_FILE"
    if [[ -f /etc/pacman.conf ]]; then
        echo "Pacman config exists: YES" >> "$REPORT_FILE"
        echo "Repositories:" >> "$REPORT_FILE"
        grep "^\[" /etc/pacman.conf >> "$REPORT_FILE"
    else
        echo "Pacman config exists: NO" >> "$REPORT_FILE"
    fi
    echo "" >> "$REPORT_FILE"
    
    # Installed packages count
    if command -v pacman >/dev/null 2>&1; then
        echo "Total installed packages: $(pacman -Qq | wc -l)" >> "$REPORT_FILE"
        echo "Explicitly installed packages: $(pacman -Qqe | wc -l)" >> "$REPORT_FILE"
    fi
    echo "" >> "$REPORT_FILE"
    
    log "Package information gathered"
}

gather_service_info() {
    section "Service Information"
    
    # Systemd status
    echo "Systemd Status:" >> "$REPORT_FILE"
    if command -v systemctl >/dev/null 2>&1; then
        systemctl is-system-running >> "$REPORT_FILE" 2>/dev/null || echo "Unknown" >> "$REPORT_FILE"
    else
        echo "systemctl not available" >> "$REPORT_FILE"
    fi
    echo "" >> "$REPORT_FILE"
    
    # Active services
    echo "Active Services:" >> "$REPORT_FILE"
    if command -v systemctl >/dev/null 2>&1; then
        systemctl list-units --state=active --type=service | head -20 >> "$REPORT_FILE"
    fi
    echo "" >> "$REPORT_FILE"
    
    # Failed services
    echo "Failed Services:" >> "$REPORT_FILE"
    if command -v systemctl >/dev/null 2>&1; then
        systemctl list-units --state=failed --type=service >> "$REPORT_FILE"
    fi
    echo "" >> "$REPORT_FILE"
    
    log "Service information gathered"
}

gather_process_info() {
    section "Process Information"
    
    # Top processes by CPU
    echo "Top 10 Processes by CPU:" >> "$REPORT_FILE"
    ps aux --sort=-%cpu | head -11 >> "$REPORT_FILE"
    echo "" >> "$REPORT_FILE"
    
    # Top processes by memory
    echo "Top 10 Processes by Memory:" >> "$REPORT_FILE"
    ps aux --sort=-%mem | head -11 >> "$REPORT_FILE"
    echo "" >> "$REPORT_FILE"
    
    log "Process information gathered"
}

gather_log_info() {
    section "Log Information"
    
    # Recent system messages
    echo "Recent System Messages:" >> "$REPORT_FILE"
    if command -v journalctl >/dev/null 2>&1; then
        journalctl --no-pager -n 50 >> "$REPORT_FILE" 2>/dev/null || echo "journalctl not available" >> "$REPORT_FILE"
    fi
    echo "" >> "$REPORT_FILE"
    
    # Recent errors
    echo "Recent Errors:" >> "$REPORT_FILE"
    if command -v journalctl >/dev/null 2>&1; then
        journalctl --no-pager -p err -n 20 >> "$REPORT_FILE" 2>/dev/null || echo "No error logs available" >> "$REPORT_FILE"
    fi
    echo "" >> "$REPORT_FILE"
    
    log "Log information gathered"
}

gather_security_info() {
    section "Security Information"
    
    # Open ports
    echo "Open Ports:" >> "$REPORT_FILE"
    if command -v ss >/dev/null 2>&1; then
        ss -tuln >> "$REPORT_FILE"
    elif command -v netstat >/dev/null 2>&1; then
        netstat -tuln >> "$REPORT_FILE"
    else
        echo "No network tools available" >> "$REPORT_FILE"
    fi
    echo "" >> "$REPORT_FILE"
    
    # User accounts
    echo "User Accounts:" >> "$REPORT_FILE"
    cat /etc/passwd | grep -v "^#" | head -10 >> "$REPORT_FILE"
    echo "" >> "$REPORT_FILE"
    
    # Sudo configuration
    echo "Sudo Configuration:" >> "$REPORT_FILE"
    if [[ -f /etc/sudoers ]]; then
        echo "sudoers file exists" >> "$REPORT_FILE"
    else
        echo "sudoers file not found" >> "$REPORT_FILE"
    fi
    echo "" >> "$REPORT_FILE"
    
    log "Security information gathered"
}

gather_performance_info() {
    section "Performance Information"
    
    # CPU usage
    echo "CPU Usage:" >> "$REPORT_FILE"
    top -bn1 | grep "Cpu(s)" >> "$REPORT_FILE" 2>/dev/null || echo "CPU info not available" >> "$REPORT_FILE"
    echo "" >> "$REPORT_FILE"
    
    # Memory usage
    echo "Memory Usage:" >> "$REPORT_FILE"
    free -h >> "$REPORT_FILE"
    echo "" >> "$REPORT_FILE"
    
    # Disk I/O
    echo "Disk I/O:" >> "$REPORT_FILE"
    if command -v iostat >/dev/null 2>&1; then
        iostat -x 1 1 >> "$REPORT_FILE" 2>/dev/null || echo "iostat not available" >> "$REPORT_FILE"
    else
        echo "iostat not available" >> "$REPORT_FILE"
    fi
    echo "" >> "$REPORT_FILE"
    
    log "Performance information gathered"
}

# Generate summary
generate_summary() {
    section "Diagnostic Summary"
    
    echo "Diagnostic report generated: $(date)" >> "$REPORT_FILE"
    echo "Report file: $REPORT_FILE" >> "$REPORT_FILE"
    echo "" >> "$REPORT_FILE"
    
    # Check for common issues
    echo "Common Issues Check:" >> "$REPORT_FILE"
    
    # Check disk space
    local disk_usage=$(df / | tail -1 | awk '{print $5}' | sed 's/%//')
    if [[ $disk_usage -gt 90 ]]; then
        echo "WARNING: Disk usage is ${disk_usage}%" >> "$REPORT_FILE"
    else
        echo "Disk usage: ${disk_usage}% (OK)" >> "$REPORT_FILE"
    fi
    
    # Check memory usage
    local mem_usage=$(free | grep Mem | awk '{printf "%.0f", $3/$2 * 100.0}')
    if [[ $mem_usage -gt 90 ]]; then
        echo "WARNING: Memory usage is ${mem_usage}%" >> "$REPORT_FILE"
    else
        echo "Memory usage: ${mem_usage}% (OK)" >> "$REPORT_FILE"
    fi
    
    # Check for failed services
    if command -v systemctl >/dev/null 2>&1; then
        local failed_services=$(systemctl list-units --state=failed --type=service | wc -l)
        if [[ $failed_services -gt 1 ]]; then
            echo "WARNING: $failed_services failed services detected" >> "$REPORT_FILE"
        else
            echo "Failed services: $failed_services (OK)" >> "$REPORT_FILE"
        fi
    fi
    
    echo "" >> "$REPORT_FILE"
    
    log "Summary generated"
}

# Main function
main() {
    echo -e "${GREEN}=== Arvora OS Diagnostic Tool ===${NC}"
    echo "Starting comprehensive system diagnostics..."
    echo "Report will be saved to: $REPORT_FILE"
    echo ""
    
    # Initialize report file
    echo "Arvora OS Diagnostic Report" > "$REPORT_FILE"
    echo "Generated: $(date)" >> "$REPORT_FILE"
    echo "========================================" >> "$REPORT_FILE"
    echo "" >> "$REPORT_FILE"
    
    # Gather all information
    gather_system_info
    gather_hardware_info
    gather_network_info
    gather_package_info
    gather_service_info
    gather_process_info
    gather_log_info
    gather_security_info
    gather_performance_info
    generate_summary
    
    echo ""
    echo -e "${GREEN}Diagnostic report completed!${NC}"
    echo "Report saved to: $REPORT_FILE"
    echo ""
    echo "To view the report:"
    echo "  cat $REPORT_FILE"
    echo "  less $REPORT_FILE"
    echo "  nano $REPORT_FILE"
}

# Help function
show_help() {
    echo "Arvora OS Diagnostic Tool"
    echo ""
    echo "Usage: arvora-diagnostics [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  -h, --help     Show this help message"
    echo "  -v, --version  Show version information"
    echo ""
    echo "This tool gathers comprehensive system information including:"
    echo "  - System and hardware information"
    echo "  - Network configuration and connectivity"
    echo "  - Package management status"
    echo "  - Service status and logs"
    echo "  - Performance metrics"
    echo "  - Security information"
    echo ""
    echo "The diagnostic report is saved to /tmp/arvora_diagnostics_YYYYMMDD_HHMMSS.txt"
}

# Version function
show_version() {
    echo "Arvora OS Diagnostic Tool v1.0"
    echo "Part of Arvora OS - Experimental Edition"
}

# Parse command line arguments
case "${1:-}" in
    -h|--help)
        show_help
        exit 0
        ;;
    -v|--version)
        show_version
        exit 0
        ;;
    "")
        main
        ;;
    *)
        echo "Unknown option: $1"
        show_help
        exit 1
        ;;
esac 