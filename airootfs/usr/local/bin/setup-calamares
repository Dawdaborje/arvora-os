#!/usr/bin/env bash
# Setup Calamares for Arvora OS
# This script configures Calamares for easy installation

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Logging function
log() {
    echo -e "${BLUE}[$(date +'%Y-%m-%d %H:%M:%S')]${NC} $1"
}

# Success function
success() {
    echo -e "${GREEN}SUCCESS:${NC} $1"
}

# Error function
error() {
    echo -e "${RED}ERROR:${NC} $1"
}

# Setup Calamares configuration
setup_calamares_config() {
    log "Setting up Calamares configuration..."
    
    # Create Calamares configuration directory
    mkdir -p /etc/calamares
    
    # Create basic configuration
    cat > /etc/calamares/settings.conf << 'EOF'
# Arvora OS Calamares Configuration
---
# Arvora OS Installer Configuration
# This file configures the Calamares installer for Arvora OS

# General settings
modules-search: [ local ]

# Module installation
installing:
  - show:
  - partition
  - mount
  - unpackfs
  - machineid
  - fstab
  - locale
  - keyboard
  - localecfg
  - luksbootkeyfile
  - luksopenswaphookcfg
  - initcpiocfg
  - initcpio
  - users
  - displaymanager
  - networkcfg
  - hwclock
  - services-systemd
  - packages
  - grubcfg
  - bootloader
  - umount
  - finished

# Module removal
removing:
  - show:

# Module show
show:
  - welcome
  - locale
  - keyboard
  - partition
  - users
  - summary

# Branding
branding: arvora

# Prompt installation
prompt-install: true

# Disable "cancel" button
dont-chroot: false

# Disable "back" button
disable-cancel-during-exec: true
disable-cancel: false

# Show debug information
debug: false

# Show debug information in log
debug-traces: false

# Show debug information in log
debug-install: false

# Show debug information in log
debug-mode: false
EOF

    success "Calamares configuration created"
}

# Setup Calamares branding
setup_calamares_branding() {
    log "Setting up Calamares branding..."
    
    # Create branding directory
    mkdir -p /etc/calamares/branding/arvora
    
    # Create branding configuration
    cat > /etc/calamares/branding/arvora/branding.desc << 'EOF'
---
# Arvora OS Calamares Branding
# This file configures the branding for Arvora OS installer

# General branding
strings:
    productName: "Arvora OS"
    shortProductName: "Arvora"
    version: "2025.07.25"
    shortVersion: "2025.07"
    bootloaderEntryName: "Arvora OS"
    productUrl: "https://github.com/Dawdaborje/arvora-os"
    supportUrl: "https://github.com/Dawdaborje/arvora-os/issues"
    knownIssuesUrl: "https://github.com/Dawdaborje/arvora-os/issues"
    releaseNotesUrl: "https://github.com/Dawdaborje/arvora-os/releases"

# Images
images:
    productLogo: "arvora-logo.png"
    productIcon: "arvora-icon.png"
    productWelcome: "arvora-welcome.png"

# Style
style:
    sidebarBackground: "49,50,53"
    sidebarText: "255,255,255"
    sidebarTextHighlight: "61,174,233"
EOF

    success "Calamares branding configured"
}

# Setup Calamares modules
setup_calamares_modules() {
    log "Setting up Calamares modules..."
    
    # Create modules directory
    mkdir -p /etc/calamares/modules
    
    # Create packages module configuration
    cat > /etc/calamares/modules/packages.conf << 'EOF'
---
# Arvora OS Package Installation
# This module installs packages for Arvora OS

# Package installation method
backend: pacman

# Update package database
update_db: true

# Install packages
packages:
  - base
  - linux
  - linux-firmware
  - grub
  - efibootmgr
  - networkmanager
  - sudo
  - vim
  - git
  - htop
  - arvora-test
  - arvora-diagnostics
EOF

    # Create users module configuration
    cat > /etc/calamares/modules/users.conf << 'EOF'
---
# Arvora OS User Configuration
# This module creates user accounts

# Default groups for users
defaultGroups:
  - users
  - wheel
  - audio
  - video
  - optical
  - storage
  - network
  - power

# Autologin group
autologinGroup: "autologin"

# Do not set password for root
doAutologin: true

# Sudoers group
sudoersGroup: wheel

# Set root password
setRootPassword: true

# Available shells
availableShells: ["/bin/bash", "/bin/zsh"]
EOF

    # Create partition module configuration
    cat > /etc/calamares/modules/partition.conf << 'EOF'
---
# Arvora OS Partition Configuration
# This module handles disk partitioning

# Default filesystem
defaultFileSystemType: "ext4"

# Ensure EFI system partition
ensureSuspendToDisk: true

# Allow manual partitioning
allowManualPartitioning: true

# Allow manual partitioning for replacement
allowManualPartitioningForReplace: true

# Initial partitioning setup
initialPartitioningChoice: "replace"

# Initial swap choice
initialSwapChoice: "small"

# Default EFI partition size
defaultEspSize: "512MiB"

# Default swap size
defaultSwapSize: "2GiB"
EOF

    success "Calamares modules configured"
}

# Create desktop shortcut
create_desktop_shortcut() {
    log "Creating desktop shortcut for Calamares..."
    
    # Create desktop directory
    mkdir -p /usr/share/applications
    
    # Create Calamares desktop file
    cat > /usr/share/applications/calamares.desktop << 'EOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=Install Arvora OS
Name[en_US]=Install Arvora OS
Comment=Install Arvora OS on your computer
Comment[en_US]=Install Arvora OS on your computer
Exec=calamares
Icon=system-software-install
Terminal=false
Categories=System;
Keywords=install;system;setup;
EOF

    success "Desktop shortcut created"
}

# Main function
main() {
    echo -e "${GREEN}=== Arvora OS Calamares Setup ===${NC}"
    echo "Setting up Calamares for easy installation..."
    echo ""
    
    setup_calamares_config
    setup_calamares_branding
    setup_calamares_modules
    create_desktop_shortcut
    
    echo ""
    echo -e "${GREEN}Calamares setup completed!${NC}"
    echo ""
    echo "You can now:"
    echo "  - Run 'calamares' to start the installer"
    echo "  - Click the 'Install Arvora OS' icon on the desktop"
    echo "  - Use the graphical installer instead of command line"
    echo ""
    echo "The installer will guide you through:"
    echo "  - Disk partitioning"
    echo "  - User account creation"
    echo "  - Package installation"
    echo "  - Bootloader configuration"
}

# Run main function
main "$@" 